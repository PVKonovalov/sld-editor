<?xml version="1.0" encoding="utf-8"?>
<!--
  Default element library bundled with sld-editor: one reusable,
  local-coordinate SVG <template> per equipment shape, drawn around the
  origin (0,0) in the shape's native (unrotated) orientation. The renderer
  (internal/slddoc.Render) places it with transform="translate(x,y)
  rotate(orient)".

  Geometry and shape codes are ported from sld-svg's symbols.xml
  (github.com/PVKonovalov/sld-svg), the sibling project that defines this
  XML format; class/name/category attributes are this editor's own
  addition, used to group and label these shapes in the Elements palette.
  A site can add further shapes without editing this file by pointing
  elements.libraries (see config/sld-editor.yaml) at one or more additional
  files in this same format — later libraries override an earlier one's
  template for a shape they both define.

  Placeholders: {color} is the voltage class's display color, except for a
  Lamp (106) and FaultPassageIndicator (320003), which aren't part of the
  electrical network — there {color} comes from the element's own
  fillOn/fillOff (Lamp) or is a fixed background fill, always the same
  regardless of State (FaultPassageIndicator — see {fpiColor} below for
  what its own State actually drives). {fill} is a state-dependent fill
  (breakers/switches only — red/lawngreen/yellow for open/closed/unknown,
  "none" when no state was recorded). {radius} is a Lamp's or
  FaultPassageIndicator's own recorded circle radius.
  {state:parallel|perpendicular|diagonal} picks one of the three given path
  "d" fragments by the element's State: parallel (drawn along the device's
  own vertical axis) for closed (1) or unrecorded, perpendicular for open
  (0), diagonal (45°) for any other recorded value. {fillAttr} and
  {stateAttr} are a real xsde2svg breaker/switch's own data-fill (the fixed
  legend of what {fill}'s three colors mean) and data-state (the element's
  raw State value) attributes — each expands to nothing when it doesn't
  apply (data-state has no recorded State to publish), so they can sit
  directly after the "d" attribute on whichever path carries {fill} or
  {state:...} without leaving a stray empty attribute behind. {fpiColor}
  is a FaultPassageIndicator's own ring/text color, driven by its State
  through a separate config legend (fpi_state_colors, not state_colors) —
  unlike {fill}, it defaults an unrecorded State to 0 (Open) rather than
  "none", since the ring is always colored. {positionAttr}/{positionOffset}
  are a withdrawable device's (Breaker/Disconnector shapes 43/49) own live
  data-trolley attribute and the x-shift it applies to the movable body's
  own wrapping <g>, driven by its Position (Service/Normal/Test) rather
  than State. {counterRotate} is the negated Orient — wrapping a fragment
  in <g transform="rotate({counterRotate})"> cancels the outer <g
  transform="...rotate(Orient)"> Render itself always emits, so that one
  fragment stays upright (e.g. FaultPassageIndicator's own "FPI" label)
  regardless of the element's own rotation, while the rest of the
  template — and the element's own terminals — still rotate normally.

  A <terminals> block (optional — a shape with none, like a busbar, simply
  isn't offered one) lists the local, unrotated points on a symbol where a
  real electrical connection can be made — e.g. a Breaker's own two stem
  ends. This is purely informational for now (Canvas draws a small red "X"
  at each one, on the current selection, as a visual aid) — Ctrl/Cmd-click-
  to-connect (diagramOps.connectElements) still just joins the two
  elements' bare anchors, not these.
-->
<symbols>
  <symbol shape="24" class="BusBarSection" name="Busbar section" category="Busbars">
    <!-- A busbar has no fixed template: its geometry is the element's own
         drawn Points (two or more vertices), rendered as a polyline
         directly by internal/slddoc.Render before this library is
         consulted. This entry exists only so the Elements palette can
         offer "Busbar section" alongside every templated shape. -->
    <template></template>
  </symbol>

  <symbol shape="3" class="Rectangle" name="Rectangle" category="Annotations">
    <!-- Like Busbar section above, a Rectangle has no fixed template: its
         size varies per instance, and it isn't real electrical equipment
         at all (no terminals, no voltage, no state — see slddoc's own
         ClassRectangle doc comment), so it's drawn straight from its own
         two Points (opposite corners) by internal/slddoc.Render, not
         template substitution. This entry exists only so the Elements
         palette can offer "Rectangle" the same drag-two-corners way it
         already offers "Busbar section". -->
    <template></template>
  </symbol>

  <symbol shape="2" class="Arrow" name="Arrow" category="Annotations">
    <!-- Like Rectangle above, an Arrow has no fixed template: its length/
         angle vary per instance, and it isn't real electrical equipment
         at all (no terminals, no voltage, no state — see slddoc's own
         ClassArrow doc comment), so it's drawn straight from its own two
         Points (start, then end — order matters, unlike Rectangle's) by
         internal/slddoc.Render, not template substitution. This entry
         exists only so the Elements palette can offer "Arrow" the same
         drag-two-points way it already offers "Rectangle"/"Busbar
         section". -->
    <template></template>
  </symbol>

  <symbol shape="4" class="Circle" name="Circle" category="Annotations">
    <!-- Like Rectangle above, a Circle has no fixed template: its size
         varies per instance, and it isn't real electrical equipment at
         all (no terminals, no voltage, no state — see slddoc's own
         ClassCircle doc comment), so it's drawn straight from its own two
         Points (opposite bounding-box corners, the exact same convention
         Rectangle uses) by internal/slddoc.Render, not template
         substitution. This entry exists only so the Elements palette can
         offer "Circle" the same drag-two-corners way it already offers
         "Rectangle". -->
    <template></template>
  </symbol>

  <symbol shape="7" class="JunctionPoint" name="Junction point" category="Wiring">
    <template><![CDATA[
<circle cx="0" cy="0" r="3" style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <!-- Ported from xsde2svg's own element_14.go (element14) — drawn where
       two crossing wires visually "hop" over each other without
       connecting. Unlike Junction point (7) above, which marks a real
       explicit node, this is purely decorative — but it still gets two
       real electrical ports, one on each side (±10, already grid-aligned),
       since each side is still a genuine node a wire's own end can land
       on; nothing about the hop itself joins the two together. -->
  <symbol shape="14" class="NonIntersection" name="Wire jump" category="Wiring">
    <terminals>
      <terminal x="-10" y="0"/>
      <terminal x="10" y="0"/>
    </terminals>
    <template><![CDATA[
<path d="M 10 0 L 3 0 A 3 3 0 0 0 -3 0 L -10 0" style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <!-- Ported from xsde2svg's own element_56.go (element56) — a cable
       termination/splice symbol, a real two-terminal electrical device
       (unlike Rectangle/Arrow/Circle above), drawn as a plain fixed
       local-coordinate template the same way Junction point/Wire jump
       are. The real source draws its own vertical stem (length 20,
       terminals at the ends) via relative path commands ("m 0 -10 v 20"
       plus four more relative segments) that work out to an open
       two-line chevron flaring outward from each terminal — decoded by
       hand here into the equivalent absolute local coordinates: the
       stem itself, then two short diagonal strokes meeting at each tip
       (mirroring Arrow's own open chevron, just unfilled and at both
       ends unconditionally, not gated by a DoubleHeaded flag). -->
  <symbol shape="56" class="CableConnector" name="Cable connector" category="Wiring">
    <terminals>
      <terminal x="0" y="-10"/>
      <terminal x="0" y="10"/>
    </terminals>
    <template><![CDATA[
<path d="M 0 -10 V 10" style="fill:none;stroke:{color};stroke-width:1" />
<path d="M 0 10 L -4 6 M 4 6 L 0 10 M 0 -10 L 4 -6 M -4 -6 L 0 -10" style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <symbol shape="41" class="Breaker" name="Breaker" category="Switching devices">
    <terminals>
      <terminal x="0" y="-10"/>
      <terminal x="0" y="10"/>
    </terminals>
    <template><![CDATA[
<path d="M -7 -7 h 14 v 14 h -14 z"{fillAttr} style="fill:{fill};stroke:{color};stroke-width:1" />
<path d="{state:M 0 -5 v 10|M -5 0 h 10|M -3.5 -3.5 l 7 7}"{stateAttr} style="stroke:{color};stroke-width:1" />
<path d="M 0 -10 v 3 M 0 10 v -3" style="stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <!-- The line+chevron pair close to the box on each side is the
       withdrawable "trolley" isolating contact; the small gap out to the
       far chevron is the isolating throw distance, drawn as a gap by
       design, not a missing connector — which is also why the two real
       terminals sit at the far chevron tips (y=±30), not at the box itself:
       that's where a wire actually attaches. The box/state-indicator/near
       chevrons are the movable body — wrapped in its own <g
       data-trolley="{Position}"> so Position status (Service/Normal/Test)
       can slide it sideways ({positionOffset}) independent of Operational
       Status (State), matching sld-viewer's own Pattern D convention
       (applyTrolleyState) — the far chevrons stay fixed outside that group,
       same as a real xsde2svg export's own fixed disconnect-contact
       stubs. -->
  <symbol shape="43" class="Breaker" name="Breaker (withdrawable)" category="Switching devices">
    <terminals>
      <terminal x="0" y="-30"/>
      <terminal x="0" y="30"/>
    </terminals>
    <template><![CDATA[
<g transform="translate({positionOffset},0)"{positionAttr}>
<path d="M -8 -8 h 17 v 17 h -17 z"{fillAttr} style="fill:{fill};stroke:{color};stroke-width:1" />
<path d="{state:M 0 -5 v 11|M -5 0 h 11|M -3.9 -3.9 l 7.8 7.8}"{stateAttr} style="stroke:{color};stroke-width:1" />
<path d="M 0 -8 v -13 m 0 0 l -4 4 m 4 -4 l 4 4 M 0 8 v 13 m 0 0 l -4 -4 m 4 4 l 4 -4" style="stroke:{color};stroke-width:1" />
</g>
<path d="M 0 -30 l -4 4 m 8 0 l -4 -4 M 0 30 l -4 -4 m 8 0 l -4 4" style="stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <symbol shape="42" class="LoadBreakSwitch" name="Load-break switch" category="Switching devices">
    <terminals>
      <terminal x="0" y="-10"/>
      <terminal x="0" y="10"/>
    </terminals>
    <template><![CDATA[
<path d="M 0 -10 v 2 m 0 16 v 2 m -8 -2 h 16 m -16 -16 h 16" style="fill:none;stroke:{color};stroke-width:1" />
<path d="M 0 -8 l 8 8 l -8 8 l -8 -8 l 8 -8"{fillAttr} style="fill:{fill};stroke:{color};stroke-width:1" />
<path d="{state:M 0 -5 v 10|M -5 0 h 10|M -3.5 -3.5 l 7 7}"{stateAttr} style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <symbol shape="162" class="Disconnector" name="Disconnector" category="Switching devices">
    <terminals>
      <terminal x="0" y="-10"/>
      <terminal x="0" y="10"/>
    </terminals>
    <template><![CDATA[
<path d="{state:M 0 6 v -13|M -6 0 h 13|M -4.6 -4.6 l 9.2 9.2}"{stateAttr} style="fill:none;stroke:{color};stroke-width:1" />
<path d="M -4 -9 h 8 m 0 18 h -8" style="fill:none;stroke:{color};stroke-width:1" />
<path d="M 0 -9 v -1 M 0 9 v 1" style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <!-- 164 Отделитель (Sectionalizer) — a two-terminal device drawn as a
       fixed pivot rod plus a small pointer arm+arrowhead, swinging between
       "closed" (rod spans both terminals straight, both fixed contact
       ticks in place, arm points in toward center) and "open" (rod tilted
       to a diagonal, pivoting at the bottom terminal — that pivot marked
       with a small circle in place of the bottom tick, since the blade
       physically rotates around it — arm swung out with it, top tick
       unchanged). The real xsde2svg source (internal/modus/element_164.go,
       element164) draws Open differently in one respect — the rod replaced
       by a short stub near the top terminal rather than the same
       full-length rod merely tilted, and the arm retracted further out —
       rejected as visually wrong for this device at the user's own
       request, in favor of the tilted-rod look (this template's own
       original Intermediate option, before this device was found to have
       no real Intermediate state at all — see below); the bottom-pivot
       circle itself, unlike that stub, *is* kept from the real source. The
       real exporter also has an xMirror flag (this schema has
       no mirroring concept, so only its non-mirrored geometry is ported —
       the same simplification every other shape here makes) and a
       busbar-spacing-dependent "leg" extension driven by sde.Distance
       (this schema has no field for that at all — omitted entirely,
       matching the common real-world case where it evaluates to a
       zero-length leg anyway; the terminal points below already sit where
       that leg would have attached, ±10, so a wire still connects in the
       right place). This device only has two real positions,
       Closed(1)/Open(0) — no Intermediate — so Properties' own State
       dropdown offers only those two (PropertiesPanel.tsx's own
       TWO_STATE_CLASSES), and this template's own {state:...} third
       ("other") option is simply a copy of "open": an Intermediate State
       value (2) on already-saved data, or any other unrecognized one,
       still reads as Open rather than something drawn specially for it. -->
  <symbol shape="164" class="Sectionalizer" name="Sectionalizer" category="Switching devices">
    <terminals>
      <terminal x="0" y="-10"/>
      <terminal x="0" y="10"/>
    </terminals>
    <template><![CDATA[
<path d="M -5 -10 h 10" style="fill:none;stroke:{color};stroke-width:1" />
<path d="{state:M -5 10 h 10|M 0 9 a 2 2 0 1 1 0 4 a 2 2 0 0 1 0 -4|M 0 9 a 2 2 0 1 1 0 4 a 2 2 0 0 1 0 -4}" style="fill:none;stroke:{color};stroke-width:1" />
<path d="{state:M 0 -9 v 18 M 0 0 h -11|M -6 -9 l 6 18 M -2 0 h -11|M -6 -9 l 6 18 M -2 0 h -11}"{stateAttr} style="fill:none;stroke:{color};stroke-width:1" />
<path d="{state:M -11 0 l 8 3 v -6 z|M -13 0 l 8 3 v -6 z|M -13 0 l 8 3 v -6 z}" style="fill:{color};stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <!-- Same withdrawable convention as shape 43 above: the two real
       terminals sit at the far chevron tips (y=±30), not the switch body
       itself, and the movable body (near chevrons/contact bars/blade) is
       wrapped in its own <g data-trolley="{Position}"> so Position status
       can slide it ({positionOffset}) independent of Operational Status
       (State) — see shape 43's own comment for the full rationale. The
       {state:...} blade options (closed/open/intermediate) were re-derived
       from the real xsde2svg source (internal/modus/element_49.go: this
       symbol's own pre-existing geometry, before this comment, was already
       confirmed to be that source's exact "Normal position, Closed" output
       byte-for-byte) — Intermediate has no real-source equivalent (the
       real exporter only models open/closed for this shape), so it instead
       reuses the plain Disconnector's (shape 162) own diagonal verbatim,
       "l 9.2 9.2" — the surrounding "m -8.6 5.4"/"m -8.6 5.4" stubs are
       this shape's own (chosen so the diagonal still runs from (-4.6,-4.6)
       to (4.6,4.6) relative to the switch's own gap center, exactly like
       162's own diagonal does relative to its center, while still meeting
       up with the fixed contact bars on either side — unlike Ground
       switch's own Intermediate, which had to invent a diagonal from
       scratch since it isn't built around the same symmetric gap). -->
  <symbol shape="49" class="Disconnector" name="Disconnector (withdrawable)" category="Switching devices">
    <terminals>
      <terminal x="0" y="-30"/>
      <terminal x="0" y="30"/>
    </terminals>
    <template><![CDATA[
<g transform="translate({positionOffset},0)"{positionAttr}>
<path d="M 0 -22 l -4 4 m 4 -4 l 4 4 m -4 -4 v 12 m -4 0 h 8 {state:m -4 2 v 16 m -4 2|m -12 10 h 16 m -12 10|m -8.6 5.4 l 9.2 9.2 m -8.6 5.4} h 8 m -4 0 v 12 l -4 -4 m 4 4 l 4 -4"{stateAttr} style="fill:none;stroke:{color};stroke-width:1" />
</g>
<path d="M 0 30 l -4 -4 m 4 4 l 4 -4 M 0 -30 l -4 4 m 4 -4 l 4 4" style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <!-- Ported from xsde2svg's own element_51.go (element51) — a withdrawable
       device's own full racking carriage/chassis symbol (Half-chassis,
       shape 52, is just one end of this same idea with the other end left
       disconnected). Own two terminals sit at ±30, matching Breaker
       (withdrawable)/Disconnector (withdrawable)'s own convention exactly
       (confirmed against two real corpus instances, one rotated one not:
       the true anchor/pivot always lands exactly at the midpoint between
       the two outer marker chevrons, ±30 from it either way). Same
       {positionOffset}/{positionAttr} withdrawable-racking mechanism as
       those two shapes (the real source's own "trolley" concept these
       placeholders were originally named after) — the movable body (the
       inner chevron-stem-chevron path, carrying the real xsde2svg source's
       own data-trolley attribute) slides sideways while the two outer
       marker chevrons stay fixed, same real-disconnect-gap convention.
       Unlike Breaker/Disconnector, this shape has no {state:...} concept
       of its own (real corpus instances never carry a data-state) — Position
       status is its only own real per-instance behavior, the same as
       Fuse (withdrawable)'s (154) own precedent. -->
  <symbol shape="51" class="Chassis" name="Chassis" category="Switching devices">
    <terminals>
      <terminal x="0" y="-30"/>
      <terminal x="0" y="30"/>
    </terminals>
    <template><![CDATA[
<g transform="translate({positionOffset},0)"{positionAttr}>
<path d="M 0 -22 l -4 4 m 4 -4 l 4 4  m -4 0 v 36 m 0 4 l -4 -4 m 4 4 l 4 -4" style="fill:none;stroke:{color};stroke-width:1" />
</g>
<path d="M 0 30 l -4 -4 m 4 4 l 4 -4 M 0 -30 l -4 4 m 4 -4 l 4 4" style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <!-- Only the stub end is a real electrical connection point — the other
       end is the earth/ground-plate symbol, a dead end representing
       "connected to the physical earth", not a node another element/wire
       can attach to (confirmed against a real xsde2svg corpus diagram,
       whose GroundSwitch elements each carry exactly one <port>). The
       terminal is grid-aligned to y=10, matching Breaker/Disconnector's
       own ±10 terminals; the stub itself was shortened from the real
       corpus's own y=12 tip to end exactly at y=10 too (a deliberate,
       minor deviation from that byte-for-byte match), so the drawn line
       stops right at the terminal instead of overshooting past it. -->
  <symbol shape="54" class="GroundSwitch" name="Ground switch" category="Switching devices">
    <terminals>
      <terminal x="0" y="10"/>
    </terminals>
    <template><![CDATA[
<path d="M 0 10 v -7 m -4 0 h 8 m -8 -20 h 8 m -4 0 v -8 m -8 0 h 16 m -2 -3 h -12 m 2 -3 h 8" style="fill:none;stroke:{color};stroke-width:1" />
<path d="{state:M 0 -2 v -12|M 6 -8 h -12|M -4.6 -12.6 l 9.2 9.2}"{stateAttr} style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <!-- Ported from xsde2svg's own element_76.go (element76): unlike every
       other switching device here, its own {state:...} indicator isn't a
       fixed-length diagonal/perpendicular/parallel line drawn *inside* a
       body outline — it *is* the entire moving part, on its own, between
       two fixed top/bottom bars (no state-driven {fill}/data-fill either;
       the real source has no such color legend for this shape, just the
       line's own orientation). The bars' own two ends (±10, already
       grid-aligned) are the real electrical connection points, same
       convention as every other vertical-stem symbol's terminals; the
       diagonal ("Intermediate") case has no real-source equivalent, same
       gap as every other switching device's own diagonal — invented at the
       same length as the parallel/perpendicular cases (±8, hence the
       ±5.7 ≈ 8·cos45°), not corpus-confirmed. -->
  <symbol shape="76" class="Starter" name="Starter" category="Switching devices">
    <terminals>
      <terminal x="0" y="-10"/>
      <terminal x="0" y="10"/>
    </terminals>
    <template><![CDATA[
<path d="M -5 -10 h 10 m 0 20 h -10" style="fill:none;stroke:{color};stroke-width:1" />
<path d="{state:M 0 -8 v 16|M 8 0 h -16|M -5.7 -5.7 l 11.4 11.4}"{stateAttr} style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <!-- The stem's own far tip (y=-10) is the one real electrical connection
       point — already grid-aligned, unlike Ground switch's own stub, so no
       shortening is needed here. The plate fan below is a dead end, same
       as Ground switch's own earth symbol — no terminal there either. -->
  <symbol shape="31" class="Ground" name="Ground terminal" category="Grounding">
    <terminals>
      <terminal x="0" y="-10"/>
    </terminals>
    <template><![CDATA[
<path d="M 0 0 v -10 m -8 10 h 16 m -2 3 h -12 m 2 3 h 8" style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <symbol shape="47" class="PowerTransformer" name="Power transformer" category="Transformers">
    <template><![CDATA[
<circle cx="18" cy="0" r="22" style="fill:none;stroke:{color};stroke-width:2" />
<path d="M 40 0 h 13" style="fill:none;stroke:{color};stroke-width:2" />
<path d="M 18 0 l -7 -7 M 18 0 l 7 -7 M 18 0 l 0 7" style="fill:none;stroke:{color};stroke-width:1" />
<circle cx="-18" cy="0" r="22" style="fill:none;stroke:{color};stroke-width:2" />
<path d="M -40 0 h -13" style="fill:none;stroke:{color};stroke-width:2" />
<path d="M -18 0 l -7 -7 M -18 0 l 7 -7 M -18 0 l 0 7" style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <!-- Ported from xsde2svg's own element_173.go (element173, non-mirrored
       case), re-anchored on its own top terminal rather than the circle's
       center: the real source's own sde.Origin *is* the circle's center
       (the stem is drawn from y-25 down *to* it), but this shape has
       exactly one real electrical connection — the stem's own far tip —
       so it follows the same "anchor = the combined path's own first
       point" convention every other single-port symbol here does (see
       parseOnePortDevice in the shared slddoc module), rather than
       ChokeCoil/Reactor's own "anchor = midpoint of two ports" one. The
       circle itself (radius 16) sits 9 units below the terminal, and the
       inner "∿" sine-wave mark (a generator's own textbook symbol) is
       drawn across its own center; stroke-width 2, matching the real
       source's own minimum for this shape (every other symbol here uses
       1, its own minimum). -->
  <symbol shape="173" class="Generator" name="Generator" category="Generation">
    <terminals>
      <terminal x="0" y="0"/>
    </terminals>
    <template><![CDATA[
<path d="M 0 0 v 9 m -16 16 a 16 16 0 0 1 32 0 a 16 16 0 0 1 -32 0 M -9 25 c 3 -3 6 -3 9 0 s 6 3 9 0" style="fill:none;stroke:{color};stroke-width:2" />
]]></template>
  </symbol>

  <!-- The vertical line is the primary conductor threaded through the CT's
       own coil loops (the two arcs) — its own two ends, at ±10, are the
       real electrical connection points; shortened from the original
       ±11 (height 22) to ±10 (height 20) so it's grid-aligned and its
       terminals sit exactly on its drawn tips, matching every other
       already-grid-aligned symbol's own terminals (e.g. Ground
       terminal's). -->
  <symbol shape="34" class="CurrentTransformer" name="Current transformer" category="Measurement">
    <terminals>
      <terminal x="0" y="-10"/>
      <terminal x="0" y="10"/>
    </terminals>
    <template><![CDATA[
<path d="M -8 -8 h 8 a 6 4 0 0 1 0 8 a 6 4 0 0 1 0 8 h -8" style="fill:none;stroke:{color};stroke-width:1" />
<path d="M 0 -10 v 20" style="fill:none;stroke:{color};stroke-width:1" />
]]></template>
  </symbol>

  <!-- Ported from xsde2svg's own element_55.go (element55) — the 2-winding
       case only: a real instance's own winding count (2, 3, or 4 circles)
       is a source-config detail the rendered SVG doesn't otherwise
       distinguish by shape/data-type code, so this picks the classic
       2-circle look, the same simplification already made for Power
       transformer's own 2-winding-only case. The single terminal sits at
       the stub's own free end (0,0) — a one-port "drop" device hanging off
       a bus, same convention as Capacitor bank's own single terminal —
       with the primary winding (top circle) taking the element's voltage
       color and the secondary (bottom circle) a fixed gray, matching a
       real corpus instance exactly (e.g. sld-viewer's
       PS_110kV_Example.svg, id="4473"). -->
  <symbol shape="55" class="VoltageTransformer" name="Voltage transformer" category="Measurement">
    <terminals>
      <terminal x="0" y="0"/>
    </terminals>
    <template><![CDATA[
<path d="M 0 0 v 5" style="fill:none;stroke:{color};stroke-width:1" />
<circle cx="0" cy="17" r="12" style="fill:none;stroke:{color};stroke-width:1" />
<circle cx="0" cy="34" r="12" style="fill:none;stroke:#D2D2D2;stroke-width:1" />
