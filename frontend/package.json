{
  "name": "sld-editor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-active-locale.mjs en && vite",
    "dev:en": "node scripts/generate-active-locale.mjs en && vite",
    "dev:ru": "node scripts/generate-active-locale.mjs ru && vite",
    "build": "node scripts/generate-active-locale.mjs en && tsc && vite build",
    "build:en": "node scripts/generate-active-locale.mjs en && tsc && vite build --outDir dist-en",
    "build:ru": "node scripts/generate-active-locale.mjs ru && tsc && vite build --outDir dist-ru",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-zoom-pan-pinch": "^4.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  }
}
